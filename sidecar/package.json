{
  "name": "open-webui-agent-sidecar",
  "version": "0.1.0",
  "description": "Node sidecar hosting the pi coding agent for Open WebUI chats",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src spec",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.3",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.16"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4"
  }
}
